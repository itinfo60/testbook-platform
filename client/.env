VITE_API_URL=/api/v1
# VITE_SOCKET_URL is intentionally blank — falls back to window.location.origin so it works on any host
VITE_RAZORPAY_KEY_ID=rzp_test_demo

# ── Local dev tenant override ──────────────────────────────────────────────
# When running on plain localhost:5173 (no subdomain), set ONE of these so the
# API interceptor sends the correct tenant header on every request.
#
# Option A: use your institute's MongoDB ObjectId (preferred — from DB or /api/v1/institutes)
# VITE_TENANT_ID=your_institute_objectid_here
#
# Option B: use your institute's subdomain slug
# VITE_TENANT_SUBDOMAIN=demo
