# ====== Server ======
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ====== Database ======
MONGODB_URI=mongodb://127.0.0.1:27017/testbook
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/testbook_test

# ====== Redis ======
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ====== JWT ======
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
JWT_RESET_PASSWORD_EXPIRY=10m
JWT_VERIFY_EMAIL_EXPIRY=24h

# ====== Cloudinary ======
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ====== Email (SMTP) ======
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@testbook.com

# ====== OAuth ======
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ====== Client URLs ======
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:8080
PLATFORM_URL=http://localhost:5175

# ====== Rate Limiting ======
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000

# ====== Razorpay ======
RAZORPAY_KEY_ID=rzp_test_T1mFOnnIE0tkcn
RAZORPAY_KEY_SECRET=PmUqk3FwAWfKGqNN1ghiLnDX
ALLOW_MOCK_PAYMENTS=true

