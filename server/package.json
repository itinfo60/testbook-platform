{
  "name": "civicsedu-server",
  "version": "2.0.0",
  "description": "Enterprise-grade learning platform API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development nodemon -e js,ts,json,mjs,cjs --import tsx src/server.js",
    "build": "npx prisma generate",
    "start": "NODE_ENV=production node --import tsx src/server.js",
    "start:cluster": "NODE_ENV=production node src/cluster.js",
    "seed": "node --import tsx scripts/seed.ts",
    "seed:admin": "node scripts/seedAdmin.js",
    "test": "NODE_ENV=test vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "seed:old": "node scripts/seedAll.js"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@langchain/core": "^1.1.48",
    "@langchain/openai": "^1.4.7",
    "@langchain/textsplitters": "^1.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "prisma": "^7.9.1",
    "tsx": "^4.22.3",
    "@sentry/node": "^10.53.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.77.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.10.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.4.2",
    "livekit-server-sdk": "^2.15.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "openai": "^6.39.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "razorpay": "^2.9.2",
    "redis": "^5.8.2",
    "socket.io": "^4.7.2",
    "speakeasy": "^2.0.0",
    "twilio": "^6.0.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "eslint": "^8.54.0",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^3.0.1",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7"
